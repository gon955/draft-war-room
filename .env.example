# Copy to .env (git-ignored) and fill in. See Draft_War_Room_SPEC.md §2.3.
#
# In production there is no .env file: the image excludes it (.dockerignore)
# and every value below is supplied as a real environment variable. Anything
# unset falls back to the default in warroom/config.py.

# ---------------------------------------------------------------------------
# Required. The app will not start without these two.
# ---------------------------------------------------------------------------
# Postgres 15 or newer — not a preference. rankings' FK uses
# ON DELETE SET NULL (tier_id), which is PG15+ syntax, and the schema is
# JSONB-heavy throughout. SQLite cannot run this app at all.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/warroom
# Sign the JWTs. Use at least 32 bytes:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Required in production, optional locally.
# ---------------------------------------------------------------------------
# Comma-separated list of origins the browser frontend is served from. The
# default is localhost only, so leaving this unset in production blocks every
# request from the deployed site — and the browser reports it as a generic
# network error that never mentions CORS.
#CORS_ORIGINS=https://warroom.pages.dev
# Cloudflare Pages gives each branch and commit its own preview host, which an
# exact list cannot match. Leave unset to allow production only.
#CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.warroom\.pages\.dev$

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------
# The suite drops and recreates every table, so it never runs against the
# database above. Unset, it derives DATABASE_URL + '_test' (warroom_test);
# set this to override. It must name a database ending in '_test'.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/warroom_test
# Fernet key for encrypting espn_s2 at rest. Without it, connecting a PRIVATE
# league returns 503 — public leagues are unaffected. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Private-league cookies — read from your browser, never commit these. Used as
# a fallback for leagues that have no cookie of their own.
ESPN_S2=
ESPN_SWID=

# ---------------------------------------------------------------------------
# Operational limits. Defaults are sized for one 512 MB / 1 shared-CPU
# container; see the README's "Operational limits" for the measurements.
# ---------------------------------------------------------------------------
# Seconds before an ESPN call is abandoned. espn-api sets none of its own.
#ESPN_TIMEOUT=15
# Must satisfy: DB_POOL_SIZE + DB_MAX_OVERFLOW >= REQUEST_THREAD_LIMIT
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=30
#DB_POOL_TIMEOUT=10
#REQUEST_THREAD_LIMIT=32
# Peak hashing memory is PASSWORD_HASH_CONCURRENCY x ARGON2_MEMORY_KIB.
#PASSWORD_HASH_CONCURRENCY=4
#ARGON2_MEMORY_KIB=19456
#ARGON2_TIME_COST=2
#ARGON2_PARALLELISM=1
# Unauthenticated attempts per address per window. 0 disables the limiter.
#AUTH_MAX_ATTEMPTS=20
#AUTH_WINDOW_SECONDS=60
# How far the survival model trusts ESPN's board over ours when predicting
# what the ROOM will take. 1.0 (default) is full market — our ranking is the
# one thing the other managers are definitely not using. 0.0 restores the old
# behaviour. Measured on one real league, full market cut survival prediction
# error from MAE 0.232 to 0.150.
#DRAFT_MARKET_WEIGHT=1.0
# /docs, /redoc and /openapi.json. Turn OFF in production unless the API
# surface is meant to be public.
#DOCS_ENABLED=false
