# Copy to .env (git-ignored) and fill in. See Draft_War_Room_SPEC.md §2.3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/warroom
JWT_SECRET=change-me
# Fernet key for encrypting espn_s2 at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Private-league cookies — read from your browser, never commit these.
ESPN_S2=
ESPN_SWID=
